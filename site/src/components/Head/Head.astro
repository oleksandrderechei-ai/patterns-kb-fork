---
// Page metadata, emitted from the page's own frontmatter, plus the one script
// tag every page loads (spec kb.pagedata.head, interfaces/built-page.md).
//
// Emitted here rather than added after the build because the frontmatter is
// right here and typed: src/content.config.ts already refuses a page without
// area and owner. The shape lives in ../../lib/page-meta.ts, shared with
// PageMeta.astro so the header's "what a machine reads" panel never drifts from
// what is emitted. tools/src/site/site-portable.ts reads these tags back into
// the article block and the manifest, and refuses a page without them.
//
// The files beside the page are linked as alternates: its markdown, and for a
// page of the knowledge base its record. Root-absolute here like every link
// the components write; the post-build pass makes them relative, and the link
// gate then proves each file is there.
import Default from '@astrojs/starlight/components/Head.astro';
import { alternateLinks, alternatesOf, jsonLdText, metaTags, pageMeta } from '../../lib/page-meta';

const { entry } = Astro.locals.starlightRoute;
const meta = pageMeta(entry);
const alternates = alternateLinks(alternatesOf(entry.filePath));
---

<Default><slot /></Default>
{metaTags(meta).map(([name, content]) => <meta name={name} content={content} />)}
{alternates.map(([type, href]) => <link rel="alternate" type={type} href={href} />)}
<script is:inline type="application/ld+json" data-kb="page" set:html={jsonLdText(meta)} />
{/*
  The one kb bundle. `is:inline` keeps Astro's script pipeline off it — the
  pipeline only ever emits type="module", which never executes from file://;
  esbuild builds public/kb.js as a classic IIFE instead (src/client/index.ts).
  The root-absolute src is made depth-relative by the post-build pass. The
  search box reads the way back to the root off this src, and loads the
  search payload beside it the first time it opens.
*/}
<script is:inline src="/kb.js" defer data-kb="bundle"></script>
{/*
  The one <style> a page may carry outside an <svg>: controls that do nothing
  until the bundle runs are taken away when no script runs. Nothing they hide is
  knowledge. `is:inline` is load-bearing: without it Astro hoists the rule into
  the stylesheet and leaves this <noscript> empty.
*/}
<noscript>
  <style is:inline>.kb-theme-toggle, .kb-meta-button, .kb-diagram-toolbar, .kb-copy, .expressive-code .copy, .kb-favourite, .kb-practiced, .kb-practiced-count, .kb-facets, .kb-search-open, .kb-home-search { display: none; }</style>
</noscript>
