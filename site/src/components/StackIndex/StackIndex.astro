---
// The pattern-to-product index on map/stack: every pattern, band by band in
// reading order, against what AWS, Azure, Google Cloud and the open-source
// world sell for it. The rows are worked out at build time from
// docs/data/relations.json and the capability pages' mapping tables
// (tools/src/lib/site-map.ts, stackData); a mapped row's cells are the
// capability page's own, copied, each product linked to its vendor's
// documentation.
//
// One instance per band, under the band's heading, which the generator writes
// as markdown (tools/src/site/gen-map-pages.ts) so the page's table of
// contents lists the bands; with no `band` it renders the index's one-line
// summary. Each row's pattern is its row header, which keeps it on one line and
// gives the search payload the row's anchor; the last column takes the slack
// (components-styling). Markup only; the classes are in stack-index.css.
import { SERVICE_COLUMNS, stackData } from '../../../../tools/src/lib/site-map';
import { repoRoot } from '../../lib/repo-root';

interface Props {
  /** The band's area id; absent for the summary. */
  band?: string;
}

const data = await stackData(repoRoot());
const band = Astro.props.band === undefined ? undefined : data.bands.find((b) => b.id === Astro.props.band);
if (Astro.props.band !== undefined && band === undefined) throw new Error(`StackIndex: no band "${Astro.props.band}" holds a pattern`);
---

{
  band === undefined ? (
    <p class="kb-stack-summary">
      All {data.patterns} patterns in one index, in {data.rows} rows: {data.sold} sold ready-made by a cloud, {data.byNature} that no
      cloud sells by nature, and {data.open} not mapped yet.
    </p>
  ) : (
    <>
      <p class="kb-stack-note">{band.description}</p>
      {band.unbuyable !== undefined && (
        <p class="kb-stack-note">
          <strong>No cloud sells these.</strong> {band.unbuyable}
        </p>
      )}
      {band.groups.map((group) => (
        <>
          {group.label !== undefined && <h3>{group.label}</h3>}
          <div class="kb-wide">
            <table class="kb-stack-table">
              <thead>
                <tr>
                  <th scope="col">Pattern</th>
                  {SERVICE_COLUMNS.map((c) => (
                    <th scope="col">{c.label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {group.rows.map((row) => (
                  <tr id={row.id} class={`kb-stack-row kb-stack-row--${row.state}`}>
                    <th scope="row">
                      <a href={row.pattern.href}>{row.pattern.title}</a>
                      {row.reason !== undefined && <span class="kb-stack-reason">No product: {row.reason}</span>}
                      {row.source !== undefined && (
                        <span class="kb-stack-source">
                          <a href={row.source.href} set:html={row.source.html} />
                        </span>
                      )}
                      {row.compare.map((c) => (
                        <a class="kb-stack-compare" href={c.href} title={c.criterion}>
                          Compare {c.title}
                        </a>
                      ))}
                    </th>
                    {row.cells.map((cell, i) => (
                      <td class:list={{ 'kb-cell-prose': i === row.cells.length - 1 }} set:html={cell} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
    </>
  )
}
